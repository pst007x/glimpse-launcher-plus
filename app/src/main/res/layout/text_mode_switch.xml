<?xml version="1.0" encoding="utf-8"?>
<!-- The Text mode switch widget: a pill (bar colour) with an icon and "Text mode: On/Off", centred in whatever room
     the host gives it. The defaults (dark pill, white ink) are what the phone's widget list shows. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/switch_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <FrameLayout
        android:layout_width="wrap_content"
        android:layout_height="52dp"
        android:layout_gravity="center">
        <ImageView
            android:id="@+id/switch_pill"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="fitXY"
            android:src="@drawable/switch_pill"
            android:importantForAccessibility="no" />
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="12dp"
            android:paddingEnd="14dp">
            <ImageView
                android:id="@+id/switch_icon"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_text_lines"
                android:importantForAccessibility="no" />
            <TextView
                android:id="@+id/switch_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:maxLines="1"
                android:text="Text mode: Off"
                android:textColor="#FFFFFFFF"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>
    </FrameLayout>
</FrameLayout>
